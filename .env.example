# --- Frontend (Vite, public; safe to expose) ---
# Supabase project URL, e.g. https://xyzcompany.supabase.co
VITE_SUPABASE_URL=
# Supabase anon/public key. Never put service-role keys in VITE_ variables.
VITE_SUPABASE_ANON_KEY=

# --- Server / Supabase functions only (set with `supabase secrets set`) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured in the Supabase dashboard, not in this file.
# Add your site URL and local URL to the provider redirect allow list.

# --- MailerSend (server-side only) ---
MAILERSEND_API_KEY=
# A sender verified in MailerSend, e.g. orders@your-domain.example
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=J-FAS
# Optional: a MailerSend template ID. Leave empty to use the built-in receipt.
MAILERSEND_TEMPLATE_ID=
